<!DOCTYPE html>
<html>
  <head>
    <title>~/blog — TUI</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script>
      (function() {
        var theme = localStorage.getItem("tui-theme") || "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="body">
    <header class="navbar">
      <div class="flex items-center gap-2">
        <span class="bg-[#7aa2f7] text-[#16161e] font-bold px-2 py-0.5 text-xs uppercase tracking-wider">
          session:0
        </span>
        <%= link_to "[1: ~/posts]",
        root_path,
        class: current_page?(root_path) ? "navbar-link-active" : "navbar-link-to" %>
        <%= link_to "[2: ~/about_me]",
        persons_path,
        class: current_page?(persons_path) ? "navbar-link-active" : "navbar-link-to" %>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" id="theme-toggle-btn" class="tui-btn" title="Alternar tema Light/Dark">
          <span id="theme-toggle-label">[theme: dark]</span>
        </button>
        <% if user_signed_in? %>
          <span class="text-xs text-[#9ece6a] hidden sm:inline">● root@blog</span>
          <%= link_to "[+new_post]", new_post_path, class: "tui-btn" %>
          <% if @post.present? && @post.persisted? && current_page?(post_path(@post)) %>
            <%= link_to "[edit]", edit_post_path(@post), class: "tui-btn-warning" %>
          <% end %>
          <%= link_to "[logout]",
          destroy_user_session_path,
          data: {
            "turbo-method": :delete,
          },
          class: "tui-btn-danger" %>
        <% else %>
          <span class="text-xs text-[#565f89]">guest@blog</span>
        <% end %>
      </div>
    </header>

    <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-6">
      <% if notice.present? %>
        <div class="mb-4 border border-[#9ece6a] bg-[#9ece6a]/10 text-[#9ece6a] px-4 py-2 text-xs flex items-center gap-2">
          <span class="font-bold">[OK]</span>
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-4 border border-[#f7768e] bg-[#f7768e]/10 text-[#f7768e] px-4 py-2 text-xs flex items-center gap-2">
          <span class="font-bold">[ERR]</span>
          <span><%= alert %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer">
      <div class="flex items-center gap-3">
        <span class="bg-[#9ece6a] text-[#16161e] font-bold px-2 py-0.5 uppercase">
          <%= user_signed_in? ? "INSERT" : "NORMAL" %>
        </span>
        <span class="text-[#7dcfff]"><%= request.path %></span>
      </div>
      <div class="flex items-center gap-4 text-[#565f89]">
        <span class="hidden sm:inline">utf-8</span>
        <span class="hidden sm:inline">unix</span>
        <span class="text-[#bb9af7]">ruby <%= RUBY_VERSION %></span>
        <span class="bg-[#414868] text-[#c0caf5] px-2 py-0.5">Top</span>
      </div>
    </footer>
  </body>
</html>

<div class="tui-prompt">
  <span class="text-[#7aa2f7]">vinicius@blog</span>:<span class="text-[#bb9af7]">~/posts</span>$
  <span class="text-[#c0caf5]">cat "<%= @post.title.parameterize %>.md"</span>
</div>

<article class="tui-box mt-6">
  <div class="tui-box-title">buffer: post #<%= @post.id %></div>

  <header class="border-b border-[#414868] pb-4 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <h1 class="text-2xl font-bold text-[#7dcfff]"><%= @post.title %></h1>
      <% if @post.draft? %>
        <span class="post-status draft">[DRAFT]</span>
      <% elsif @post.scheduled? %>
        <span class="post-status scheduled">[SCHED: <%= @post.published_at.strftime("%Y-%m-%d") %>]</span>
      <% elsif @post.published? %>
        <span class="post-date"><%= @post.published_at.strftime("%Y-%m-%d %H:%M") %></span>
      <% end %>
    </div>

    <% if @post.tag_list.any? %>
      <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
        <span class="text-[#565f89]">tags:</span>
        <% @post.tag_list.each do |t| %>
          <%= link_to "##{t}", tag_path(t), class: "tui-tag" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="prose prose-invert max-w-none font-mono text-[#c0caf5] prose-headings:text-[#7dcfff] prose-a:text-[#7aa2f7] prose-strong:text-[#e0af68] prose-code:text-[#9ece6a]">
    <%= @post.content %>
  </div>

  <footer class="mt-8 pt-4 border-t border-dashed border-[#414868] flex justify-between items-center text-xs">
    <%= link_to "[q] cd ..", root_path, class: "tui-btn" %>
    <% if user_signed_in? %>
      <%= link_to "[e] edit buffer", edit_post_path(@post), class: "tui-btn-warning" %>
    <% end %>
  </footer>
</article>

<section class="tui-box mt-8">
  <div class="tui-box-title">
    stdout: comments (<span id="comments-count"><%= @post.comments.count %></span>)
  </div>

  <div id="comments-list" class="space-y-3 mb-6">
    <% top_comments = @post.comments.top_level.includes(:replies) %>
    <% if top_comments.any? %>
      <% top_comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    <% else %>
      <p id="no-comments-placeholder" class="text-xs text-[#565f89]">
        -- no comments yet. be the first to write to stdout --
      </p>
    <% end %>
  </div>

  <div class="border-t border-[#414868] pt-4">
    <h3 class="text-xs font-bold uppercase tracking-widest text-[#9ece6a] mb-3">
      ──[ Write Comment ]─────────────
    </h3>
    <div id="new-comment-form">
      <%= render "comments/form", post: @post, comment: Comment.new, parent_id: nil %>
    </div>
  </div>
</section>

<div class="tui-prompt">
  <span class="text-[#7aa2f7]">vinicius@blog</span>:<span class="text-[#bb9af7]">~/posts</span>$
  <span class="text-[#c0caf5]">nvim "<%= @post.title.parameterize %>.md"</span>
</div>

<div class="tui-box mt-6">
  <div class="flex justify-between items-center mb-4">
    <div class="tui-box-title !mb-0">edit post #<%= @post.id %></div>
    <%= button_to "[rm -f] Delete",
    @post,
    method: :delete,
    data: {
      turbo_confirm: "Confirm deletion?",
    },
    class: "tui-btn-danger" %>
  </div>
  <%= render partial: "form", locals: { post: @post } %>
</div>
<%= form_with model: person, class: "space-y-5" do |form| %>
  <% if form.object.errors.any? %>
    <div class="border border-[#f7768e] bg-[#f7768e]/10 text-[#f7768e] p-3 text-xs space-y-1">
      <div class="font-bold uppercase">[ERR] Validation failed:</div>
      <% form.object.errors.full_messages.each do |message| %>
        <div>- <%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :name, "--name" %>
      <%= form.text_field :name, class: "w-full" %>
    </div>

    <div>
      <%= form.label :role, "--role" %>
      <%= form.text_field :role, class: "w-full" %>
    </div>

    <div>
      <%= form.label :email, "--email" %>
      <%= form.email_field :email, class: "w-full" %>
    </div>

    <div>
      <%= form.label :phone, "--phone" %>
      <%= form.text_field :phone, class: "w-full" %>
    </div>
  </div>

  <div>
    <%= form.label :summary, "--summary" %>
    <%= form.text_area :summary, rows: 4, class: "w-full" %>
  </div>

  <div class="border border-[#414868] bg-[#16161e] p-4 space-y-3">
    <h2 class="text-xs font-bold uppercase tracking-widest text-[#9ece6a]">──[ Educations ]</h2>
    <%= form.fields_for :educations do |education_form| %>
      <%= render "education_fields", f: education_form %>
    <% end %>
    <%= link_to "[+ Add Education]", "#", class: "tui-btn", data: { target: "add-education" } %>
  </div>

  <div class="border border-[#414868] bg-[#16161e] p-4 space-y-3">
    <h2 class="text-xs font-bold uppercase tracking-widest text-[#9ece6a]">──[ Certificates ]</h2>
    <%= form.fields_for :certificates do |certificate_form| %>
      <%= render "certificate_fields", f: certificate_form %>
    <% end %>
    <%= link_to "[+ Add Certificate]", "#", class: "tui-btn", data: { target: "add-certificate" } %>
  </div>

  <div class="border border-[#414868] bg-[#16161e] p-4 space-y-3">
    <h2 class="text-xs font-bold uppercase tracking-widest text-[#9ece6a]">──[ Experiences ]</h2>
    <%= form.fields_for :professional_experiences do |experience_form| %>
      <%= render "professional_experience_fields", f: experience_form %>
    <% end %>
    <%= link_to "[+ Add Experience]", "#", class: "tui-btn", data: { target: "add-experience" } %>
  </div>

  <div class="border border-[#414868] bg-[#16161e] p-4 space-y-3">
    <h2 class="text-xs font-bold uppercase tracking-widest text-[#9ece6a]">──[ Skills ]</h2>
    <%= form.fields_for :skills do |skill_form| %>
      <%= render "skill_fields", f: skill_form %>
    <% end %>
    <%= link_to "[+ Add Skill]", "#", class: "tui-btn", data: { target: "add-skill" } %>
  </div>

  <div class="pt-2 flex items-center gap-3">
    <%= form.submit ":wq (Save)", class: "tui-btn-primary" %>
    <%= link_to ":q! (Cancel)", persons_path, class: "tui-btn" %>
  </div>
<% end %>

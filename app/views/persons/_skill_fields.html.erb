<div class="skill-fields border border-[#414868] p-3 mb-2 space-y-2">
  <%= f.hidden_field :id %>
  <%= f.label :name %>
  <%= f.text_field :name, class: "w-full" %>

  <%= f.label :proficiency_level %>
  <%= f.number_field :proficiency_level, max: 5, class: "w-full" %>

  <div class="flex items-center gap-2 pt-1">
    <%= f.check_box :_destroy %>
    <%= f.label :_destroy, "Remove", class: "!mb-0 text-[#f7768e]" %>
  </div>
</div>

<button type="button" class="add-skill-btn tui-btn">
  [+ Add Skill]
</button>

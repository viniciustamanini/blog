<div class="skill-fields border border-[#414868] bg-[#1f2335] p-3 space-y-3" data-nested-item>
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= f.label :name %>
      <%= f.text_field :name, class: "w-full" %>
    </div>
    <div>
      <%= f.label :proficiency_level, "Proficiency Level (1-5)" %>
      <%= f.number_field :proficiency_level, min: 1, max: 5, class: "w-full" %>
    </div>
  </div>

  <div class="flex justify-end pt-1">
    <button type="button" class="tui-btn-danger" data-remove-nested>
      [x] Remove Skill
    </button>
  </div>
</div>

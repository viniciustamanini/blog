<div class="professional-experience-fields border border-[#414868] bg-[#1f2335] p-3 space-y-3" data-nested-item>
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= f.label :company_name %>
      <%= f.text_field :company_name, class: "w-full" %>
    </div>
    <div>
      <%= f.label :role %>
      <%= f.text_field :role, class: "w-full" %>
    </div>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description, rows: 3, class: "w-full" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= f.label :started_on %>
      <%= f.date_field :started_on, class: "w-full" %>
    </div>
    <div>
      <%= f.label :ended_on %>
      <%= f.date_field :ended_on, class: "w-full" %>
    </div>
  </div>

  <div class="flex justify-end pt-1">
    <button type="button" class="tui-btn-danger" data-remove-nested>
      [x] Remove Experience
    </button>
  </div>
</div>


<% if @comment.parent_id.present? %>
  <%= turbo_stream.append "replies-for-#{@comment.parent_id}" do %>
    <%= render "comments/comment", comment: @comment %>
  <% end %>
  <%= turbo_stream.replace "reply-form-#{@comment.parent_id}" do %>
    <div id="reply-form-<%= @comment.parent_id %>" class="hidden mt-3 pt-3 border-t border-dashed border-[#414868]">
      <%= render "comments/form",
      post: @post,
      comment: Comment.new(parent_id: @comment.parent_id),
      parent_id: @comment.parent_id %>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.remove "no-comments-placeholder" %>
  <%= turbo_stream.append "comments-list" do %>
    <%= render "comments/comment", comment: @comment %>
  <% end %>
  <%= turbo_stream.replace "new-comment-form" do %>
    <div id="new-comment-form">
      <%= render "comments/form", post: @post, comment: Comment.new, parent_id: nil %>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.update "comments-count" do %>
  <%= @post.comments.count %>
<% end %>
